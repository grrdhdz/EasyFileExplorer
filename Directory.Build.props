<Project>
  <PropertyGroup>

    <!--  Generic properties  -->
    <TargetFrameworkVersion>net10.0</TargetFrameworkVersion>
    <TargetWindowsVersion>10.0.26100.0</TargetWindowsVersion>
    <MinimalWindowsVersion>10.0.19041.0</MinimalWindowsVersion>
    <WindowsSdkPackageVersion>10.0.26100.67-preview</WindowsSdkPackageVersion>
    <WindowsTargetFramework>$(TargetFrameworkVersion)-windows$(TargetWindowsVersion)</WindowsTargetFramework>
    <LangVersion>preview</LangVersion>
    <WarningsAsErrors>nullable</WarningsAsErrors>

    <!--  Use Microsoft.Testing.Platform  -->
    <EnableMSTestRunner>true</EnableMSTestRunner>

    <!--  Use strict Roslyn compilation mode  -->
    <Features>strict</Features>

    <!--  Enable all C#/WinRT trimming and NativeAOT diagnostics  -->
    <CsWinRTAotWarningLevel>3</CsWinRTAotWarningLevel>

  </PropertyGroup>

  <!--  Unpackaged self-contained build for local dev on machines without MSIX activation (e.g. Windows Server).
        Enable with: msbuild -p:UnpackagedDev=true -r win-x64  -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Files.App' and '$(UnpackagedDev)' == 'true'">
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <DefineConstants>$(DefineConstants);UNPACKAGED_DEV</DefineConstants>
  </PropertyGroup>
</Project>

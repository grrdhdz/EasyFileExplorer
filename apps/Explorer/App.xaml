<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="EasyFileExplorer.Explorer.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:EasyFileExplorer.Explorer.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <conv:FileSizeConverter x:Key="FileSize" />
            <conv:DateFormatConverter x:Key="DateFormat" />
            <conv:ItemGlyphConverter x:Key="ItemGlyph" />
            <conv:NullToVisibilityConverter x:Key="NullToVis" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </Application.Resources>
</Application>

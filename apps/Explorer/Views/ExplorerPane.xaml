<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="EasyFileExplorer.Explorer.Views.ExplorerPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:vm="using:EasyFileExplorer.Explorer.ViewModels"
    xmlns:dom="using:EasyFileExplorer.Domain">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barra superior: navegación, breadcrumbs y búsqueda -->
        <Grid Grid.Row="0" Padding="8,4" ColumnSpacing="8" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="2">
                <muxc:Button ToolTipService.ToolTip="Back (Alt+Left)" IsEnabled="{x:Bind ViewModel.CanGoBack, Mode=OneWay}"
                             Command="{x:Bind ViewModel.GoBackCommand}">
                    <FontIcon Glyph="&#xE72B;" />
                </muxc:Button>
                <muxc:Button ToolTipService.ToolTip="Forward (Alt+Right)" IsEnabled="{x:Bind ViewModel.CanGoForward, Mode=OneWay}"
                             Command="{x:Bind ViewModel.GoForwardCommand}">
                    <FontIcon Glyph="&#xE72A;" />
                </muxc:Button>
                <muxc:Button ToolTipService.ToolTip="Up (Alt+Up)" Command="{x:Bind ViewModel.GoUpCommand}">
                    <FontIcon Glyph="&#xE74A;" />
                </muxc:Button>
                <muxc:Button ToolTipService.ToolTip="Home" Command="{x:Bind ViewModel.GoHomeCommand}">
                    <FontIcon Glyph="&#xE80F;" />
                </muxc:Button>
            </StackPanel>

            <Grid Grid.Column="1" VerticalAlignment="Center">
                <muxc:BreadcrumbBar x:Name="Breadcrumbs" ItemsSource="{x:Bind ViewModel.Breadcrumbs, Mode=OneWay}" ItemClicked="OnBreadcrumbClicked">
                    <muxc:BreadcrumbBar.ItemTemplate>
                        <DataTemplate x:DataType="dom:LocationSegment">
                            <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" />
                        </DataTemplate>
                    </muxc:BreadcrumbBar.ItemTemplate>
                </muxc:BreadcrumbBar>
                <TextBox x:Name="AddressBox" Text="{x:Bind ViewModel.Address, Mode=OneWay}"
                         Visibility="Collapsed" VerticalAlignment="Center"
                         KeyDown="OnAddressKeyDown" LostFocus="OnAddressLostFocus" />
            </Grid>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                <muxc:AutoSuggestBox x:Name="SearchBox" Width="220" PlaceholderText="Search folder"
                                     QueryIcon="Find" QuerySubmitted="OnSearchSubmitted" />
                <muxc:Button x:Name="OperationsButton" ToolTipService.ToolTip="Operations" Click="OnOperationsClicked">
                    <FontIcon Glyph="&#xE9D9;" />
                </muxc:Button>
            </StackPanel>
        </Grid>

        <!-- Contenido: panel lateral + lista -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                          Background="{ThemeResource LayerFillColorDefaultBrush}"
                          BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
                <StackPanel x:Name="SideNav" Padding="6,4" Spacing="2" />
            </ScrollViewer>

            <Grid Grid.Column="1" Padding="8,0,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="100" />
                    </Grid.ColumnDefinitions>
                    <muxc:Button Grid.Column="1" Content="Name" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" Click="OnSortName" />
                    <muxc:Button Grid.Column="2" Content="Date modified" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" Click="OnSortModified" />
                    <muxc:Button Grid.Column="3" Content="Type" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" Click="OnSortType" />
                    <muxc:Button Grid.Column="4" Content="Size" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" Click="OnSortSize" />
                </Grid>

                <!-- Vista de detalles virtualizada -->
                <muxc:ListView x:Name="FileList" Grid.Row="1" Background="Transparent"
                               ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                               SelectionMode="Extended"
                               CanDragItems="True" AllowDrop="True"
                               IsItemClickEnabled="False"
                               SelectionChanged="OnSelectionChanged"
                               ContainerContentChanging="OnContainerContentChanging"
                               DragItemsStarting="OnDragItemsStarting"
                               DragOver="OnListDragOver" Drop="OnListDrop"
                               DoubleTapped="OnListDoubleTapped"
                               KeyDown="OnListKeyDown">
                    <muxc:ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ItemViewModel">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>
                                <Grid VerticalAlignment="Center">
                                    <FontIcon x:Name="Glyph" Glyph="{x:Bind Item, Converter={StaticResource ItemGlyph}, Mode=OneWay}" FontSize="16"
                                              Visibility="{x:Bind Thumbnail, Converter={StaticResource NullToVis}, ConverterParameter=invert, Mode=OneWay}" />
                                    <Image x:Name="Thumb" Width="20" Height="20" Stretch="Uniform"
                                           Source="{x:Bind Thumbnail, Mode=OneWay}"
                                           Visibility="{x:Bind Thumbnail, Converter={StaticResource NullToVis}, Mode=OneWay}" />
                                </Grid>
                                <TextBlock Grid.Column="1" Text="{x:Bind Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{x:Bind ModifiedUtc, Converter={StaticResource DateFormat}, Mode=OneWay}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="3" Text="{x:Bind TypeText}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="4" Text="{x:Bind SizeText}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </muxc:ListView.ItemTemplate>
                    <muxc:ListView.ContextFlyout>
                        <muxc:MenuFlyout x:Name="ItemMenu" Opening="OnItemMenuOpening">
                            <muxc:MenuFlyoutItem x:Name="MenuOpen" Text="Open" Click="OnMenuOpen" />
                            <muxc:MenuFlyoutItem x:Name="MenuOpenWith" Text="Open with..." Click="OnMenuOpenWith" />
                            <muxc:MenuFlyoutSeparator />
                            <muxc:MenuFlyoutItem Text="Cut" Click="OnMenuCut" />
                            <muxc:MenuFlyoutItem Text="Copy" Click="OnMenuCopy" />
                            <muxc:MenuFlyoutItem Text="Paste" Click="OnMenuPaste" />
                            <muxc:MenuFlyoutItem Text="Copy path" Click="OnMenuCopyPath" />
                            <muxc:MenuFlyoutSeparator />
                            <muxc:MenuFlyoutItem Text="Rename" Click="OnMenuRename" />
                            <muxc:MenuFlyoutItem Text="Delete" Click="OnMenuDelete" />
                            <muxc:MenuFlyoutSeparator />
                            <muxc:MenuFlyoutItem Text="Properties" Click="OnMenuProperties" />
                        </muxc:MenuFlyout>
                    </muxc:ListView.ContextFlyout>
                </muxc:ListView>

                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                            x:Name="EmptyState"
                            Visibility="{x:Bind ViewModel.EmptyVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <FontIcon Glyph="&#xE8B7;" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="This folder is empty" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,8,0,0" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Barra de estado -->
        <Grid Grid.Row="2" Padding="12,4" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <muxc:ProgressRing Width="16" Height="16" IsIndeterminate="True"
                               Visibility="{x:Bind ViewModel.IsEnumerating, Mode=OneWay}" />
        </Grid>
    </Grid>
</UserControl>

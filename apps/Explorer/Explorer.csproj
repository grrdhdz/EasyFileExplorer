<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>EasyFileExplorer.Explorer</RootNamespace>
    <AssemblyName>EasyFileExplorer</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Desempaquetado para desarrollo local; MSIX en packaging/. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Platforms>x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\libs\Domain\Domain.csproj" />
    <ProjectReference Include="..\..\libs\FileSystem\FileSystem.csproj" />
    <ProjectReference Include="..\..\libs\Navigation\Navigation.csproj" />
    <ProjectReference Include="..\..\libs\Operations\Operations.csproj" />
  </ItemGroup>
</Project>
